-- TAIL (CONS a (CONS b (CONS c (CONS d NIL))))
-- ==> (CONS b (CONS c (CONS d NIL))







eval mul_2_3: 
  MUL TWO THREE
  =*> THREE (ADD TWO) ZERO
  =*> ADD TWO (ADD TWO (ADD TWO (ZERO)))
  =*> SIX

-- ((ZERO + n) + n) + ... + n) "add n to ZERO m times"


