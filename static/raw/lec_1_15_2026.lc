-- let FST  p = p TT

-- let ZERO f x =  x
-- let ONE  = \f x -> f x
-- let TWO f x = f (f x)
-- let INC n =  (\f x -> f (n f x))

eval INC0: 
  INC ZERO
  =*> (\f x -> f (ZERO f x))
  =*> (\f x -> f x)
  =*> ONE

eval INC1:
  INC TWO 
  =*> (\f x -> f (TWO f x))
  =*> (\f x -> f (f (f x)))








eval pairFst: 
  FST (PACK apple banana)
  =*> FST (\chooser -> chooser apple banana)
  =*> (\chooser -> chooser apple banana) TT
  =*> TT apple banana
  =*> apple

