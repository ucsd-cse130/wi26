let TT = \x1 x2 -> x1
let FF = \x1 x2 -> x2
let ITE = \b xThen xElse -> b xThen xElse
let NOT = \b -> ITE b FF TT 
let NOT1 = \b -> (\x1 x2 -> b x2 x1)
let AND = \b1 b2 -> ITE b1 b2 FF
let OR  = \b1 b2 -> ITE b1 TT b2



let PACK = \x1 x2 -> (\selector -> selector x1 x2)
let FST  = \obj -> obj TT
let SND  = \obj -> obj FF


{- 

