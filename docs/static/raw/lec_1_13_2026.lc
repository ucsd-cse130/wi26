eval not_tt:
  NOT1 TT
  =d> (\b -> (\x1 x2 -> b x2 x1))   TT
  =b> (\x1 x2 -> TT x2 x1)
  =d> (\x1 x2 -> (\x1 x2 -> x1) x2 x1)
  =a> (\x1 x2 -> (\a x2 -> a) x2 x1)
  =a> (\x1 x2 -> (\a b -> a) x2 x1)
  =b> (\x1 x2 -> (\b -> x2)  x1)
  =b> (\x1 x2 -> x2)
  =~> FF
  


{- 

NOT TT ==> FF
NOT FF ==> TT

 




let LHS = \x y z -> RHS

LHS x y z ===> RHS 

let ITE b xThen xElse ===> b xThen xElse


let TT = \x1 x2 -> x1

TT x1 x2 ===> x1
FF x1 x2 ===> x2


  ITE TT app ban
  
  ===> 
  
  TT app ban
  
  ===>
  
  app


ITE FF app ban === FF app ban == ban


-}







eval if_true: 
  ITE TT app ban
  =d>  (\b xThen xElse -> b xThen xElse)  TT app ban
  =b>  (\xThen xElse -> TT xThen xElse)   app ban
  =b>  (\xElse -> TT app xElse)   ban
  =b>  TT app ban
  =d> ( \x1 x2 -> x1) app ban
  =b> ( \x2 -> app)  ban
  =b> app  

eval if_false: 
  ITE FF app ban
  =d>  (\b xThen xElse -> b xThen xElse)  FF app ban
  =b>  (\xThen xElse -> FF xThen xElse)   app ban
  =b>  (\xElse -> FF app xElse)   ban
  =b>  FF app ban
  =d> ( \x1 x2 -> x2) app ban
  =b> ( \x2 -> x2)  ban
  =b> ban  





eval funny: 
      ((\x1 -> \x2 -> \x3 -> apple) apple) banana orange
  =b> (( \x2 -> \x3 -> apple)) banana orange
  =b> ((\x3 -> apple))  orange
  =b> apple

