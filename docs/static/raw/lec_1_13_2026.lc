let ONE  = \f x -> f x
let TWO  = \f x -> f (f x)
let THREE =\f x -> f (f (f x))
let FOUR = \f x -> f (f (f (f x)))

ZERO bob apple = apple
ONE bob apple = bob apple
TWO bob apple = bob (bob apple)
THREE bob apple = bob (bob (bob apple))
FOUR bob apple = bob (bob (bob (bob apple)))

"n" bob apple = bob ... (bob apple)

n f x = 'hit x with f n-times'

= 


let INC = \n -> (\f x -> f (n f x) ) 

INC ZERO = ONE
INC ONE  = TWO
INC TWO  = THREE




let PACK3 = \x1 x2 x3 -> (\selector -> selector x1 x2 x3)
let FST3  = \obj -> obj (\x1 x2 x3 -> x1)
let SND3  = \obj -> obj (\x1 x2 x3 -> x2)
let THD3  = \obj -> obj (\x1 x2 x3 -> x3)



FST3 (PACK3 apple banana chip)
=*> apple 

SND3 (PACK3 apple banana chip)
=*> banana

THD3 (PACK3 apple banana chip)
=*> chip
-}




eval packFst: 
  FST (PACK apple banana)
  =*> FST (\b -> b apple banana)
  =*> (\b -> b apple banana) TT
  =*> TT apple banana
  =*> apple

eval packSnd: 
  SND (PACK apple banana)
  =*> SND (\b -> b apple banana)
  =*> (\b -> b apple banana) FF
  =*> FF apple banana
  =*> banana


